        "query": "-- KI-Modelle aus der Modellwahl (Einstellungen > KI); 5_3_zusammenfassung_erstellen nutzt modell_einfach (Stefan 18.10.2026)\n-- ki_gesperrt/ki_sperre_text: KI-Budget erreicht (Budget-Modus \"Sperren\") = keine Zusammenfassung, Hinweis an den Aufrufer (Stefan 18.10.2026)\nSELECT ki_modell('einfach') AS modell_einfach, ki_modell('anspruchsvoll') AS modell_anspruchsvoll,\n  ki_gesperrt() AS ki_gesperrt, ki_sperre_text() AS ki_sperre_text;"
      },
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "UJpN09uPs1n9LVAk",
          "name": "Postgres n8n_data"
        }
