    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, papierkram_id, timebuzzer_tile_id, entity_type, status, last_synced_hash, extra_data, composite_key\nFROM sync_mapping\nWHERE entity_type IN ('task', 'project', 'customer')\nAND status = 'active'",
        "options": {}
      },
      "name": "Mapping prüfen (DB)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        16,
        432
      ],
      "id": "da5fd7fb-fc42-4b61-a07c-41088049b52e",
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "UJpN09uPs1n9LVAk",
          "name": "Postgres n8n_data"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Ebene der Aufgaben kommt aus TB 2 (unterste der drei timeBuzzer-Ebenen), nicht fest (17.10.2026).\nconst EBENE = Number($('Ebenen (TB 2)').first().json.aufgaben);\nconst rawTiles = $('TB – Aufgaben-Tiles abrufen').all();\nconst tiles = rawTiles.map(item => item.json);\nconst rawMappings = $('Mapping prüfen (DB)').all();\nconst mappings = rawMappings.map(item => item.json);\n\nconst existingByCompositeKey = {};\n// Zusaetzlich nach Projekt-Kachel + Aufgaben-Kachel (ohne Kunde): so wird eine Aufgabe nach einem Kundenwechsel\n// des Projekts wiedergefunden und aktualisiert, statt archiviert und doppelt neu angelegt.\nconst existingByProjectTask = {};\nconst projectMappings = {};\nconst customerMappings = {};\n\nfor (const m of mappings) {\n  if (m.entity_type === 'task' && m.composite_key) {\n    const e = {\n      pk_id: String(m.papierkram_id),\n      hash: m.last_synced_hash || '',\n      mapping_db_id: m.id,\n      composite_key: m.composite_key\n    };\n    existingByCompositeKey[m.composite_key] = e;\n    const teile = m.composite_key.split('|');\n    existingByProjectTask[teile[1] + '|' + teile[2]] = e;\n  }\n  if (m.entity_type === 'project') {\n    projectMappings[String(m.timebuzzer_tile_id)] = {\n      pk_id: String(m.papierkram_id),\n      extra_data: m.extra_data\n    };\n  }\n  if (m.entity_type === 'customer') {\n    customerMappings[String(m.papierkram_id)] = String(m.timebuzzer_tile_id);\n  }\n}\n\nconst customerTileByProjectTile = {};\nfor (const [tbProjectTile, projData] of Object.entries(projectMappings)) {\n  const companyId = projData.extra_data;\n  if (companyId) {\n    const customerTile = customerMappings[String(companyId)];\n    if (customerTile) customerTileByProjectTile[tbProjectTile] = customerTile;\n  }\n}\n\n// Alle aktiven Aufgaben je Projekt-Kachel (unabhaengig vom Kunden)\nconst activeProjectTaskKeys = new Set();\nfor (const tile of tiles) {\n  if (tile.layer !== EBENE || tile.archived) continue;\n  const tb_id = String(tile.id);\n  const parents = tile.parents && tile.parents.length > 0 ? tile.parents : [];\n  for (const parentId of parents) {\n    const parentTileId = String(parentId);\n    if (!projectMappings[parentTileId]) continue;\n    activeProjectTaskKeys.add(parentTileId + '|' + tb_id);\n  }\n}\n\nconst results = [];\n\n// Archivieren: gemappte Aufgaben, deren Aufgaben-Kachel unter diesem Projekt nicht mehr aktiv ist\nfor (const [compositeKey, mapping] of Object.entries(existingByCompositeKey)) {\n  const teile = compositeKey.split('|');\n  if (!activeProjectTaskKeys.has(teile[1] + '|' + teile[2])) {\n    results.push({\n      json: {\n        tb_id: teile[2],\n        pk_id: mapping.pk_id,\n        mapping_db_id: mapping.mapping_db_id,\n        action: 'archive'\n      }\n    });\n  }\n}\n\n// Create / Update / Skip\nfor (const tile of tiles) {\n  if (tile.layer !== EBENE) continue;\n  if (tile.archived) continue;\n\n  const tb_id = String(tile.id);\n  const parents = tile.parents && tile.parents.length > 0 ? tile.parents : [];\n\n  if (parents.length === 0) {\n    results.push({ json: { tb_id, name: tile.name, action: 'skip', reason: 'no_parent' } });\n    continue;\n  }\n\n  for (const parentId of parents) {\n    const parentTileId = String(parentId);\n    const projData = projectMappings[parentTileId];\n\n    if (!projData) {\n      results.push({ json: { tb_id, name: tile.name, parentTileId, action: 'skip', reason: 'no_project_mapping' } });\n      continue;\n    }\n\n    const pkProjectId = projData.pk_id;\n    const customerTileId = customerTileByProjectTile[parentTileId] || null;\n    const compositeKey = `${customerTileId}|${parentTileId}|${tb_id}`;\n    const currentHash = `${tile.name}|${compositeKey}`;\n\n    const existing = existingByCompositeKey[compositeKey] || existingByProjectTask[parentTileId + '|' + tb_id];\n\n    if (existing) {\n      if (existing.hash === currentHash) {\n        results.push({ json: { tb_id, pk_id: existing.pk_id, action: 'skip' } });\n      } else {\n        results.push({\n          json: {\n            tb_id,\n            pk_id: existing.pk_id,\n            mapping_db_id: existing.mapping_db_id,\n            name: tile.name,\n            pkProjectId,\n            parentTileId,\n            customerTileId,\n            compositeKey,\n            current_hash: currentHash,\n            action: 'update'\n          }\n        });\n      }\n      continue;\n    }\n\n    results.push({\n      json: {\n        tb_id,\n        name: tile.name,\n        pkProjectId,\n        parentTileId,\n        customerTileId,\n        compositeKey,\n        current_hash: currentHash,\n        action: 'create'\n      }\n    });\n  }\n}\nreturn results;\n"
      },
