        "jsCode": "// Ergebnisse zuordnen (Stefan 18.10.2026): Ergebnis je Vorlage (gleiche Reihenfolge wie die Aufträge)\nconst V = $('Vorlagen').all();\nreturn $input.all().map((it, i) => {\n  const e = it.json || {};\n  const fehler = e.error ? String(e.error.message || e.error) : (e.ok === true ? '' : String(e.grund || e.text || 'Bericht nicht erstellt.'));\n  return { json: { vorlage_id: V[i] ? V[i].json.vorlage_id : '', daten: JSON.stringify({ ok: e.ok === true, bericht_id: e.bericht_id || null, fehler: fehler.slice(0, 400) }) } };\n}).filter(x => x.json.vorlage_id !== '');\n"
