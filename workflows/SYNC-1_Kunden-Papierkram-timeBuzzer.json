        "query": "WITH upd AS (\n  UPDATE sync_mapping\n  SET timebuzzer_tile_id = '{{ $json.id }}',\n      status = 'active',\n      last_synced_hash = '{{ String($('Aktion bestimmen').item.json.current_hash ?? '').replace(/'/g, \"''\") }}',\n      last_synced_at = NOW(),\n      name = '{{ String($('Aktion bestimmen').item.json.name ?? '').replace(/'/g, \"''\") }}'\n  WHERE id = NULLIF('{{ $('Aktion bestimmen').item.json.mapping_db_id || '' }}', '')::int\n  RETURNING id\n)\nINSERT INTO sync_mapping (entity_type, papierkram_id, timebuzzer_tile_id, last_synced_hash, last_synced_at, source_of_creation, status, name)\nSELECT\n  'customer',\n  '{{ $('Aktion bestimmen').item.json.pk_id }}',\n  '{{ $json.id }}',\n  '{{ String($('Aktion bestimmen').item.json.current_hash ?? '').replace(/'/g, \"''\") }}',\n  NOW(),\n  'papierkram',\n  'active',\n  '{{ String($('Aktion bestimmen').item.json.name ?? '').replace(/'/g, \"''\") }}'\nWHERE NOT EXISTS (SELECT 1 FROM upd);\n",
