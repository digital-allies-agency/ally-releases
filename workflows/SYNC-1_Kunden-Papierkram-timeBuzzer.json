    {
      "parameters": {
        "jsCode": "// Aktion bestimmen (SYNC 1): Papierkram ist fuehrend. Beruecksichtigt werden nur aktive Kunden.\n// Ist die Kachel eines aktiven Kunden in timeBuzzer archiviert, wird sie reaktiviert; ist sie geloescht, wird sie neu angelegt.\n// Ebene der Kunden kommt aus TB 2 (oberste timeBuzzer-Ebene), nicht fest (17.10.2026).\nconst EBENE = Number($('Ebenen (TB 2)').first().json.kunden);\nconst customers = $('Kunden extrahieren').first().json.customers;\nconst allMappings = $('Mapping prüfen (DB)').all().map(i => i.json).filter(m => m.id);\nconst tbTiles = $('TB – Kunden-Tiles prüfen').all().map(i => i.json).filter(t => !t.archived && t.layer === EBENE);\n// timeBuzzer liefert nur nicht archivierte Kacheln. Fehlt eine Kachel hier, ist sie archiviert oder geloescht.\nconst vorhandeneKacheln = new Set(tbTiles.map(t => String(t.id)));\n// Einzelstatus aus TB 1: aktiv | archiviert | geloescht\nconst kachelStatus = $('Kachelstatus (TB 1)').first().json.status || {};\n\nconst mappingsByPkId = {};\nfor (const m of allMappings) mappingsByPkId[m.papierkram_id] = m;\n\nconst tbTilesByName = {};\nfor (const t of tbTiles) tbTilesByName[t.name] = t;\n\nconst activeCustomerPkIds = new Set(customers.map(c => c.pk_id));\n\nconst colorMap = {\n  'blue': '#64bef8ff', 'pink': '#ef9a9aff', 'green': '#43a047ff',\n  'yellow': '#fdd835ff', 'red': '#e53935ff', 'orange': '#fb8c00ff', 'purple': '#9c27b0ff'\n};\n\nconst results = [];\n\n// Aktive Kunden verarbeiten\nfor (const customer of customers) {\n  const mapping = mappingsByPkId[customer.pk_id];\n  const tbTile = tbTilesByName[customer.name];\n  const currentHash = customer.name + '|' + (customer.color || '');\n  const tbColor = colorMap[customer.color] || '#64bef8ff';\n\n  let action;\n  if (mapping) {\n    const st = kachelStatus[String(mapping.timebuzzer_tile_id)];\n    if (!st) throw new Error('Kachelstatus fehlt für Kunde ' + customer.name + ' – Sync abgebrochen, nichts geändert.');\n    if (st === 'geloescht') action = 'create';\n    else if (mapping.status === 'archived' || st === 'archiviert') action = 'reactivate';\n    else action = mapping.last_synced_hash !== currentHash ? 'update' : 'skip';\n  } else if (tbTile) {\n    action = 'link';\n  } else {\n    action = 'create';\n  }\n\n  results.push({\n    json: {\n      pk_id: customer.pk_id,\n      name: customer.name,\n      action,\n      tbColor,\n      tb_tile_id: mapping?.timebuzzer_tile_id || tbTile?.id || null,\n      mapping_db_id: mapping?.id || null,\n      current_hash: currentHash\n    }\n  });\n}\n\n// Nicht mehr aktive Kunden -> archivieren\nfor (const mapping of allMappings) {\n  if (!activeCustomerPkIds.has(mapping.papierkram_id) && mapping.status !== 'archived') {\n    const tileName = (mapping.last_synced_hash || '').split('|')[0];\n    results.push({\n      json: {\n        pk_id: mapping.papierkram_id,\n        name: tileName,\n        // Ist die Kachel in timeBuzzer schon archiviert oder geloescht, wird nur das Sync-Gedaechtnis angepasst\n        action: vorhandeneKacheln.has(String(mapping.timebuzzer_tile_id)) ? 'archive' : 'archive_db',\n        tbColor: null,\n        tb_tile_id: mapping.timebuzzer_tile_id,\n        mapping_db_id: mapping.id,\n        current_hash: null\n      }\n    });\n  }\n}\n\nreturn results;\n"
      },
