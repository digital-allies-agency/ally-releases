        "jsCode": "// Kachel-IDs sammeln (SYNC 1): Kacheln aller Zuordnungen, deren Kunde in Papierkram aktiv ist.\n// TB 1 prueft danach einzeln, ob die Kachel in timeBuzzer aktiv, archiviert oder geloescht ist.\nconst aktiv = new Set($('Kunden extrahieren').first().json.customers.map(c => c.pk_id));\nconst ids = $('Mapping prüfen (DB)').all().map(i => i.json)\n  .filter(m => m.id && aktiv.has(m.papierkram_id) && m.timebuzzer_tile_id)\n  .map(m => String(m.timebuzzer_tile_id));\nreturn [{ json: { kacheln: ids.join(',') } }];\n",
