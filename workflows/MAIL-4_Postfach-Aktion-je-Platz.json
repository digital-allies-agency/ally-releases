    {
      "id": "890e5de9-7758-4adc-90e6-8d8f480f08ed",
      "name": "Ordner zusammenfassen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        3200
      ],
      "parameters": {
        "jsCode": "// Ordnerliste eines Postfachs zusammenfassen (nur Pfade). Genau ein Auftrag je Lauf.\nconst auftraege = $('Auftrag prüfen').all();\nif (auftraege.length !== 1) throw new Error('Ordner lesen geht nur für ein Postfach je Lauf.');\nconst a = auftraege[0].json;\nconst ordner = [...new Set($input.all().map(i => String((i.json || {}).path || '').trim()).filter(Boolean))];\nif (!ordner.length) throw new Error('Im Postfach ' + a.postfach + ' wurden keine Ordner gefunden.');\nreturn [{ json: { platz: a.platz, postfach: a.postfach, ordner: JSON.stringify(ordner) } }];"
      }
    },
