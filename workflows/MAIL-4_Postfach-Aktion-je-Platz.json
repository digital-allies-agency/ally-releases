      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Der Platz kommt nur aus der Platz-Liste, nie vom Aufrufer\n-- Migration 173 (Schritt P, P3): dazu Weg, Stand und Workflow des Postfachs (eigene Nummer: Aktion im Workflow „MAIL Postfach Nr. n“)\nSELECT platz, adresse, credential_id, weg, stand, empfang_workflow_id FROM postfach_plaetze WHERE adresse = lower(trim($1::text));",
        "options": {
          "queryReplacement": "={{ [ String($json.postfach || '') ] }}"
        }
      },
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "UJpN09uPs1n9LVAk",
          "name": "Postgres n8n_data"
        }
      }
    },
    {
      "id": "a85aa07b-340a-4a16-9ab6-9faeb4f6f456",
      "name": "Auftrag prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        2624
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Sicherheitsnetz: Aktion nur im Postfach der Mail, über den Workflow genau dieses Postfachs („MAIL Postfach Nr. n“, Nummer und Workflow aus der Datenbank).\n// P5 (Aufräumen nach P4): der Platz-Weg (Plätze 1–10 mit festen Zugangsdaten) ist entfernt; jedes Postfach muss fertig eingerichtet sein (weg eigen, stand aktiv).\nconst a = $('Start').item.json;\nconst p = $input.item.json || {};\nconst aktion = String(a.aktion || '').trim();\nconst postfach = String(a.postfach || '').trim().toLowerCase();\nif (!['verschieben', 'markieren', 'entwurf', 'ordner_lesen'].includes(aktion)) throw new Error('Unbekannte Postfach-Aktion \"' + aktion + '\". Nichts ausgeführt.');\nif (!p.platz) throw new Error('Das Postfach ' + (postfach || '(leer)') + ' ist nicht eingerichtet. Nichts ausgeführt.');\nconst platz = Number(p.platz);\nif (!Number.isInteger(platz) || platz < 1) throw new Error('Postfach Nr. ' + p.platz + ' ist hier nicht eingerichtet. Nichts ausgeführt.');\nif (p.weg !== 'eigen' || p.stand !== 'aktiv' || !/^[A-Za-z0-9]{8,40}$/.test(String(p.empfang_workflow_id || ''))) throw new Error('Postfach Nr. ' + platz + ' ist nicht fertig eingerichtet. Nichts ausgeführt.');\nif (String(p.adresse || '').toLowerCase() !== postfach) throw new Error('Postfach und Nummer passen nicht zusammen. Nichts ausgeführt.');\nlet uid = null;\nif (aktion === 'verschieben' || aktion === 'markieren') {\n  uid = Number(a.uid);\n  if (!Number.isInteger(uid) || uid <= 0) throw new Error('Die Mail-Nummer (UID) fehlt. Nichts ausgeführt.');\n}\nconst ziel = String(a.ziel_ordner || '').trim();\nif (aktion === 'verschieben' && !ziel) throw new Error('Zielordner fehlt. Nichts verschoben.');\nconst ordner = String(a.ordner || '').trim();\nconst rfc822 = String(a.rfc822 || '');\nif (aktion === 'entwurf') {\n  if (!ordner || !rfc822.trim()) throw new Error('Entwurf oder Entwurfsordner fehlt. Kein Entwurf angelegt.');\n  const kopf = rfc822.split(/\\r?\\n\\r?\\n/)[0];\n  const von = (kopf.match(/^From:.*$/im) || [''])[0].toLowerCase();\n  if (!von.includes(postfach)) throw new Error('Absender des Entwurfs passt nicht zum Postfach ' + postfach + '. Kein Entwurf angelegt.');\n}\nreturn { json: { aktion, postfach, platz, uid, ziel_ordner: ziel, ordner, rfc822, test: a._test === true, weg: 'eigen', nr: platz, workflow_id: String(p.empfang_workflow_id) } };\n"
      }
    },
