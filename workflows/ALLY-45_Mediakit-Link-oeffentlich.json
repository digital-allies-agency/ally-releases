    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Antwort (ALLY 45): nur ein echtes PDF (beginnt mit %PDF-) geht hinaus, zum Ansehen im Browser (inline, Name der Datei); sonst Fehlerseite ohne Einzelheiten.\nconst it = $input.first() || {}, j = it.json || {}, bin = it.binary && it.binary.datei;\nconst r = ($('Link prüfen').first().json || {}).r || {};\nlet kopf = '';\nif (j.ok === true && bin) { try { kopf = (await this.helpers.getBinaryDataBuffer(0, 'datei')).subarray(0, 5).toString('latin1'); } catch (e) { kopf = ''; } }\nif (kopf !== '%PDF-') return [{ json: { da: false, r: { code: 503, text: 'Das Mediakit ist gerade nicht verfügbar. Bitte später erneut versuchen.' } } }];\nconst name = String(r.name || 'Mediakit.pdf').replace(/[\\x00-\\x1f\\x7f\"\\\\\\/]/g, '_').slice(0, 200) || 'Mediakit.pdf';\nconst ascii = name.normalize('NFKD').replace(/[^\\x20-\\x7e]/g, '').replace(/[%;]/g, '_') || 'Mediakit.pdf';\nconst utf8 = encodeURIComponent(name).replace(/['()*]/g, c => '%' + c.charCodeAt(0).toString(16).toUpperCase());\nreturn [{ json: { da: true, disposition: 'inline; filename=\"' + ascii + '\"; filename*=UTF-8\\'\\'' + utf8 }, binary: { datei: Object.assign({}, bin, { mimeType: 'application/pdf' }) } }];\n"
      },
