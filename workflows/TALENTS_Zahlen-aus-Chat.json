      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Auftrag (Stefan 18.10.2026): Zahlen, die das Talent im Chat als Text geschickt hat, an \"TALENTS Zahlen auslesen\" (Quelle chat).\n// Brücke mit festen Feldern für das Chat-Werkzeug in ALLY 1, weil \"TALENTS Zahlen auslesen\" alle Daten annimmt (Dateien kommen dort direkt an).\nconst e = $input.first().json || {};\nconst s = v => String(v ?? '').trim();\nreturn [{ json: { quelle: 'chat', nutzer: s(e.nutzer), talent: s(e.talent).slice(0, 120), text: s(e.text).slice(0, 30000) } }];\n"
      }
    },
