      ],
      "parameters": {
        "jsCode": "// Migration 179 (P6): neu gestartet, wenn der Workflow danach mit derselben Fassung aktiv ist; sonst aus (nächster Versuch in 5 Minuten nur mit dieser Fassung)\nconst e = $('Neustart erlaubt?').first().json, nach = ($input.first().json || {}).body || {};\nconst ok = ($input.first().json || {}).statusCode === 200 && nach.active === true && String(nach.activeVersionId || '') === e.fassung;\nconst st = n => ($(n).first().json || {}).statusCode;\nreturn [{ json: { id: e.id, ergebnis: ok ? 'neu_gestartet' : 'aus', fassung: e.fassung,\n  grund: ok ? '' : 'Ausschalten ' + st('Ausschalten') + ', Einschalten ' + st('Einschalten') + ', danach aktiv ' + (nach.active === true) } }];"
      }
