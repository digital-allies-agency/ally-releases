      "parameters": {
        "jsCode": "// Prüfung P6 S1: Ausschalten ging nicht (Workflow danach nicht aus) – nicht einschalten, als fehlgeschlagener Versuch eintragen\nconst e = $('Neustart erlaubt?').first().json, a = $('Ausschalten').first().json || {}, g = $input.first().json || {};\nreturn [{ json: { id: e.id, ergebnis: 'fehlgeschlagen', fassung: e.fassung, grund: 'Ausschalten ' + a.statusCode + ', danach aktiv ' + ((g.body || {}).active === true) + ' (Status ' + g.statusCode + ')' } }];"
