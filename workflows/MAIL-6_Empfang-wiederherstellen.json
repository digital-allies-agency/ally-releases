    },
    {
      "id": "mail6-ergebnisse",
      "name": "Ergebnisse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        600
      ],
      "parameters": {
        "jsCode": "// Migration 179 (P6): Ergebnisse der Postfach-Workflows (nur Zahlen) dem Postfach zuordnen; Fehler einzelner Postfächer (z. B. Anmeldung) halten die anderen nicht auf\nconst M = $('Merkwerte').all().map(i => i.json);\nreturn $input.all().flatMap(it => { const r = it.json || {}; const p = M.find(m => m.platz === Number(r.nr));\n  if (!p || r.aktion !== 'empfang_pruefen' || !Number.isInteger(r.uid_next) || !Number.isInteger(r.neue) || Number(r.letzte) !== p.letzte) return [];\n  return [{ json: { platz: p.platz, wf: p.wf, uid_next: r.uid_next, letzte: p.letzte, neue: r.neue } }]; });"
      }
    },
