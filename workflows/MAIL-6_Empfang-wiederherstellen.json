    {
      "id": "mail6-schaltzustand",
      "name": "Schaltzustand",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        800
      ],
      "parameters": {
        "jsCode": "// Migration 204 (Fehler Nr. 47, Stefan 03.11.2026): Schaltzustand des Empfangs je Postfach so, wie n8n ihn meldet (Antwort 200 von „Workflow lesen“, genau der\n// Workflow „MAIL Postfach Nr. n“ des Postfachs). Für die Seite Postfächer.\n// Migration 204, Prüfung 1 (Fehler Nr. 47, Stefan 03.11.2026), L2: ohne lesbare Antwort „nicht bekannt“ mit Grund (aktiv = null), damit die Seite es zeigt.\nconst P = $('Postfächer laden').all();\nconst stand = $input.all().flatMap((it, i) => { const p = (P[i] || {}).json || {}, r = it.json || {}, b = r.body || {};\n  if (!p.wf) return [];\n  if (r.statusCode !== 200) return [{ platz: Number(p.platz), wf: String(p.wf), aktiv: null, grund: 'Schaltzustand in n8n nicht abrufbar (' + (r.statusCode || 'keine Antwort') + ').' }];\n  if (String(b.id || '') !== String(p.wf) || String(b.name || '') !== 'MAIL Postfach Nr. ' + p.platz || typeof b.active !== 'boolean')\n    return [{ platz: Number(p.platz), wf: String(p.wf), aktiv: null, grund: 'Der Workflow heißt in n8n nicht „MAIL Postfach Nr. ' + p.platz + '“.' }];\n  return [{ platz: Number(p.platz), wf: String(p.wf), aktiv: b.active }]; });\nreturn [{ json: { stand: JSON.stringify(stand) } }];"
      }
    },
    {
      "id": "mail6-schaltzustand-eintragen",
