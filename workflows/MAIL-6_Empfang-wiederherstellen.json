      "parameters": {
        "jsCode": "// Migration 179 (P6): nur neu starten, was sicher derselbe Stand bleibt: Name „MAIL Postfach Nr. n“, veröffentlichte Fassung = Entwurf (publish veröffentlicht\n// sonst den Entwurf). War der Workflow nach einem eigenen früheren Versuch aus (Einschalten gescheitert), nur mit genau der damals veröffentlichten Fassung.\nconst f = $('Fällige holen').first().json, r = $input.first().json || {}, b = r.body || {};\nlet grund = '';\nif (r.statusCode !== 200) grund = 'Der Workflow ist nicht erreichbar (' + (r.statusCode || 'keine Antwort') + ').';\nelse if (String(b.id || '') !== f.workflow_id || String(b.name || '') !== 'MAIL Postfach Nr. ' + f.platz) grund = 'Der Workflow heißt nicht „MAIL Postfach Nr. ' + f.platz + '“.';\nelse if (b.active === true && String(b.versionId || '') !== String(b.activeVersionId || '')) grund = 'Der Workflow hat nicht veröffentlichte Änderungen.';\nelse if (b.active !== true && !(f.fassung && String(b.versionId || '') === f.fassung)) grund = 'Der Workflow ist ausgeschaltet.';\nreturn [{ json: { id: f.id, platz: f.platz, workflow_id: f.workflow_id, versuch: f.versuch, aktiv: b.active === true,\n  fassung: String((b.active === true ? b.activeVersionId : b.versionId) || ''), erlaubt: !grund, ergebnis: grund ? 'nicht_angefasst' : '', grund } }];"
      }
