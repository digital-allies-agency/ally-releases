    {
      "id": "mail6-merkwerte",
      "name": "Merkwerte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        600
      ],
      "parameters": {
        "jsCode": "// Migration 179 (P6): je Postfach die zuletzt geholte Mail (lastMessageUid des Auslösers, staticData) – nur Zahlen. Ohne gemerkte Mail (noch nie eine geholt) oder\n// wenn der Workflow aus ist, keine Prüfung (dafür gibt es SYS 7 und ALLY 9).\nconst P = $('Postfächer laden').all();\nreturn $input.all().flatMap((it, i) => { const p = P[i].json, r = it.json || {}, b = r.body || {};\n  const ausl = (b.nodes || []).find(k => k.type === 'n8n-nodes-base.emailReadImap');\n  const m = ausl && b.staticData && b.staticData['node:' + ausl.name];\n  const letzte = m ? Number(m.lastMessageUid) : NaN;\n  // Prüfung P6 S2: nur der Workflow „MAIL Postfach Nr. n“ dieses Postfachs\n  if (r.statusCode !== 200 || String(b.id || '') !== p.wf || String(b.name || '') !== 'MAIL Postfach Nr. ' + p.platz || b.active !== true || !Number.isInteger(letzte) || letzte < 0) return [];\n  return [{ json: { aktion: 'empfang_pruefen', nr: p.platz, uid: letzte, workflow_id: p.wf, platz: p.platz, wf: p.wf, letzte } }]; });"
      }
    },
