    {
      "parameters": {
        "jsCode": "// Projekte extrahieren: vollstaendige Projektliste kommt aus PK 2 (alle Seiten, auf Vollstaendigkeit geprueft).\n// Weitergegeben werden nur aktive Projekte.\nconst eintraege = $input.first().json.eintraege;\nif (!Array.isArray(eintraege)) throw new Error('Projektliste aus PK 2 fehlt – Sync abgebrochen, nichts geändert.');\nconst projects = eintraege\n  .filter(e => e.record_state === 'active')\n  .map(e => ({\n    pk_id: String(e.id),\n    name: e.name,\n    color: e.color,\n    company_id: String(e.company_id)\n  }));\nreturn [{ json: { projects } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "505e2c45-5412-43ae-ae04-d68f02bc6214",
      "name": "Projekte extrahieren"
    },
    {
      "parameters": {
        "url": "={{ 'https://my.timebuzzer.com/open-api/tiles?layer=' + $('Ebenen (TB 2)').first().json.projekte }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1040,
        0
      ],
      "id": "81783219-282e-49dd-8686-381ab06733ef",
      "name": "TB – Projekt-Tiles prüfen",
      "executeOnce": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "UPef5xIprBI4hw17",
          "name": "timeBuzzer API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Aktion bestimmen (SYNC 2): Papierkram ist fuehrend. Beruecksichtigt werden nur aktive Projekte aktiver Kunden.\n// Erkannt werden: neues Projekt, Name/Farbe geaendert, Kundenwechsel, Projekt oder Kunde archiviert,\n// Kachel eines aktiven Projekts in timeBuzzer archiviert (wird reaktiviert) oder geloescht (wird neu angelegt).\n// Ebene der Projekte kommt aus TB 2 (Unterebene der Kunden), nicht fest (17.10.2026).\nconst EBENE = Number($('Ebenen (TB 2)').first().json.projekte);\nconst projects = $('Projekte extrahieren').first().json.projects;\nconst allMappings = $('Mapping prüfen (DB)').all().map(i => i.json).filter(m => m.id);\nconst customerMappings = $('Kunden-Mapping laden (DB)').all().map(i => i.json).filter(m => m.id);\nconst tbTiles = $('TB – Projekt-Tiles prüfen').all().map(i => i.json).filter(t => !t.archived && t.layer === EBENE);\n// timeBuzzer liefert nur nicht archivierte Kacheln. Fehlt eine Kachel hier, ist sie archiviert oder geloescht.\nconst vorhandeneKacheln = new Set(tbTiles.map(t => String(t.id)));\n// Einzelstatus aus TB 1: aktiv | archiviert | geloescht\nconst kachelStatus = $('Kachelstatus (TB 1)').first().json.status || {};\n\nconst mappingsByPkId = {};\nfor (const m of allMappings) mappingsByPkId[m.papierkram_id] = m;\n\n// Kacheln aller Kunden (fuer das Archivieren) und nur der aktiven Kunden (fuer aktive Projekte)\nconst customerTileByPkId = {};\nconst activeCustomerTileByPkId = {};\nfor (const m of customerMappings) {\n  customerTileByPkId[m.papierkram_id] = m.timebuzzer_tile_id;\n  if (m.status === 'active') activeCustomerTileByPkId[m.papierkram_id] = m.timebuzzer_tile_id;\n}\n\nconst tbTilesByNameAndParent = {};\nfor (const t of tbTiles) {\n  const key = t.name + '|' + (t.parents[0] || '');\n  tbTilesByNameAndParent[key] = t;\n}\n\n// Nur Projekte, deren Kunde aktiv ist\nconst relevant = projects.filter(p => activeCustomerTileByPkId[p.company_id]);\nconst activeProjectPkIds = new Set(relevant.map(p => p.pk_id));\n\nconst colorMap = {\n  'blue': '#64bef8ff', 'pink': '#ef9a9aff', 'green': '#43a047ff',\n  'yellow': '#fdd835ff', 'red': '#e53935ff', 'orange': '#fb8c00ff', 'purple': '#9c27b0ff'\n};\n\nconst results = [];\n\nfor (const project of relevant) {\n  const mapping = mappingsByPkId[project.pk_id];\n  const currentHash = project.name + '|' + (project.color || '');\n  const tbColor = colorMap[project.color] || '#64bef8ff';\n  const parentTileId = activeCustomerTileByPkId[project.company_id];\n  const tbTile = tbTilesByNameAndParent[project.name + '|' + parentTileId];\n\n  let action;\n  if (mapping) {\n    const st = kachelStatus[String(mapping.timebuzzer_tile_id)];\n    if (!st) throw new Error('Kachelstatus fehlt für Projekt ' + project.name + ' – Sync abgebrochen, nichts geändert.');\n    if (st === 'geloescht') action = 'create';\n    else if (mapping.status === 'archived' || st === 'archiviert') action = 'reactivate';\n    else if (mapping.last_synced_hash !== currentHash || String(mapping.extra_data || '') !== project.company_id) action = 'update';\n    else action = 'skip';\n  } else if (tbTile) {\n    action = 'link';\n  } else {\n    action = 'create';\n  }\n\n  results.push({\n    json: {\n      pk_id: project.pk_id,\n      name: project.name,\n      company_id: project.company_id,\n      action,\n      kundenwechsel: !!(mapping && String(mapping.extra_data || '') !== project.company_id),\n      tbColor,\n      parent_tile_id: parentTileId,\n      tb_tile_id: mapping?.timebuzzer_tile_id || tbTile?.id || null,\n      mapping_db_id: mapping?.id || null,\n      current_hash: currentHash\n    }\n  });\n}\n\n// Archivieren: Projekt nicht mehr aktiv oder Kunde nicht mehr aktiv\nfor (const mapping of allMappings) {\n  if (!activeProjectPkIds.has(mapping.papierkram_id) && mapping.status !== 'archived') {\n    const tileName = (mapping.last_synced_hash || '').split('|')[0];\n    const companyId = mapping.extra_data || null;\n    const parentTileId = companyId ? customerTileByPkId[companyId] : null;\n    results.push({\n      json: {\n        pk_id: mapping.papierkram_id,\n        name: tileName,\n        // Ist die Kachel in timeBuzzer schon archiviert oder geloescht, wird nur das Sync-Gedaechtnis angepasst\n        action: vorhandeneKacheln.has(String(mapping.timebuzzer_tile_id)) ? 'archive' : 'archive_db',\n        tbColor: null,\n        parent_tile_id: parentTileId,\n        tb_tile_id: mapping.timebuzzer_tile_id,\n        mapping_db_id: mapping.id,\n        current_hash: null\n      }\n    });\n  }\n}\n\nreturn results;\n"
      },
