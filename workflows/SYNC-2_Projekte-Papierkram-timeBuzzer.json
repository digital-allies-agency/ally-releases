      "name": "Kachel-IDs sammeln",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        200
      ],
      "parameters": {
        "jsCode": "// Kachel-IDs sammeln (SYNC 2): Kacheln aller Zuordnungen von Projekten, die in Papierkram aktiv sind und zu einem aktiven Kunden gehoeren.\n// TB 1 prueft danach einzeln, ob die Kachel in timeBuzzer aktiv, archiviert oder geloescht ist.\nconst projects = $('Projekte extrahieren').first().json.projects;\nconst aktiveKunden = new Set($('Kunden-Mapping laden (DB)').all().map(i => i.json).filter(m => m.id && m.status === 'active').map(m => m.papierkram_id));\nconst relevant = new Set(projects.filter(p => aktiveKunden.has(p.company_id)).map(p => p.pk_id));\nconst ids = $('Mapping prüfen (DB)').all().map(i => i.json)\n  .filter(m => m.id && relevant.has(m.papierkram_id) && m.timebuzzer_tile_id)\n  .map(m => String(m.timebuzzer_tile_id));\nreturn [{ json: { kacheln: ids.join(',') } }];\n",
        "mode": "runOnceForAllItems"
      },
      "executeOnce": true
    },
