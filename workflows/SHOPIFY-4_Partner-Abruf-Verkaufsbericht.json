      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Fehlerseite (SHOPIFY 4): schlichte Seite ohne Skripte und ohne Einzelheiten nach außen (Produktname aus den Einstellungen ist nicht nötig).\nconst j = $input.first().json || {};\nconst r = j.r || {};\nconst code = [404, 410, 429, 503].includes(Number(r.code)) ? Number(r.code) : 503;\nconst text = r.text ? String(r.text) : 'Der Bericht konnte gerade nicht erstellt werden. Bitte später erneut versuchen.';\nconst esc = v => String(v ?? '').replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst html = '<!doctype html><html lang=\"de\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"noindex\"><title>Verkaufsbericht</title>' +\n  '<style>body{font-family:system-ui,-apple-system,Segoe UI,sans-serif;background:#f4f5f3;color:#1f2933;margin:0;display:flex;min-height:100vh;align-items:center;justify-content:center}' +\n  'main{background:#fff;border:1px solid #dde1dc;border-radius:14px;padding:28px 32px;max-width:460px;margin:16px}h1{font-size:20px;margin:0 0 10px}p{margin:0;line-height:1.5}</style></head>' +\n  '<body><main><h1>Verkaufsbericht</h1><p>' + esc(text) + '</p></main></body></html>';\nreturn [{ json: { status: code, html } }];\n"
      }
