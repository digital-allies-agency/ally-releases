    {
      "id": "728739a4-3463-539f-8ecb-e1e62bc0b493",
      "name": "Leere Reste entfernen",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        400
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Migration 173 (Schritt P, P3): Reservierungen ohne angelegte Teile (seit über einer Stunde) bzw. Reste ohne IDs: Zeile weg\nSELECT postfach_rest_abschliessen(p.platz, '{}'::jsonb) AS r FROM postfach_plaetze p\nWHERE p.weg = 'eigen' AND p.adresse IS NULL AND p.empfang_workflow_id IS NULL AND p.credential_id IS NULL AND p.smtp_credential_id IS NULL\n  AND (p.stand = 'unvollstaendig' OR (p.stand = 'reserviert' AND p.reserviert_am < now() - interval '1 hour'));",
        "options": {}
      },
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "UJpN09uPs1n9LVAk",
          "name": "Postgres n8n_data"
        }
      }
    },
    {
      "id": "a7bf5846-92bd-5253-9008-90723ebc98a7",
      "name": "Reste laden",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        600
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Migration 173 (Schritt P, P3): Reste eigener Postfächer (unvollstaendig oder seit über einer Stunde reserviert), höchstens 20 je Lauf. Gelöscht wird nur eine ID,\n-- die keine andere Zeile nutzt und nicht der Versand für Systemnachrichten ist.\nSELECT p.platz,\n  CASE WHEN NOT EXISTS (SELECT 1 FROM postfach_plaetze q WHERE q.platz <> p.platz AND q.empfang_workflow_id = p.empfang_workflow_id) THEN p.empfang_workflow_id END AS wf,\n  CASE WHEN NOT EXISTS (SELECT 1 FROM postfach_plaetze q WHERE q.platz <> p.platz AND (q.credential_id = p.credential_id OR q.smtp_credential_id = p.credential_id)) THEN p.credential_id END AS imap,\n  CASE WHEN NOT EXISTS (SELECT 1 FROM postfach_plaetze q WHERE q.platz <> p.platz AND (q.credential_id = p.smtp_credential_id OR q.smtp_credential_id = p.smtp_credential_id))\n    AND p.smtp_credential_id IS DISTINCT FROM (SELECT e.wert FROM ally_einstellungen e WHERE e.schluessel = 'systemnachrichten_credential_id') THEN p.smtp_credential_id END AS smtp\nFROM postfach_plaetze p\nWHERE p.weg = 'eigen' AND p.adresse IS NULL AND (p.stand = 'unvollstaendig' OR (p.stand = 'reserviert' AND p.reserviert_am < now() - interval '1 hour'))\n  AND (p.empfang_workflow_id IS NOT NULL OR p.credential_id IS NOT NULL OR p.smtp_credential_id IS NOT NULL)\nORDER BY p.platz LIMIT 20;",
        "options": {}
      },
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "UJpN09uPs1n9LVAk",
          "name": "Postgres n8n_data"
        }
      }
    },
