    {
      "id": "b3d7af8b-e463-56a1-a4ff-e8204aa17e16",
      "name": "Zugang-Reste",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        720
      ],
      "parameters": {
        "jsCode": "// Migration 173 (Schritt P, P3): je übrig gebliebener Zugangs-ID ein Eintrag (Lesen bzw. Versand)\nreturn $('Reste laden').all().flatMap(it => { const r = it.json || {}; const ok = x => /^[A-Za-z0-9]{8,40}$/.test(String(x || ''));\n  return [ok(r.imap) ? { json: { platz: r.platz, teil: 'imap', id: String(r.imap) } } : null, ok(r.smtp) ? { json: { platz: r.platz, teil: 'smtp', id: String(r.smtp) } } : null].filter(Boolean); });"
      },
      "executeOnce": true
    },
