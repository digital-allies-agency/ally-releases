    {
      "id": "61af0a74-09a8-4a0c-aa30-c97cfc6ec0dd",
      "name": "Ergebnis für Ally",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        400
      ],
      "parameters": {
        "jsCode": "// Ergebnis für Ally: Eckdaten des Berichts oder der genaue Grund, warum keiner erstellt wurde\nconst r = $input.first().json || {};\nif (r.ok === true) return [{ json: { status: 'Bericht erstellt', bericht: r.titel, kunde: r.kunde, projekt: r.projekt, zeitraum: r.zeitraum, zeiteintraege: r.eintraege, erfasste_zeit: r.zeit + ' h (' + r.stunden + ' Std.)', summe_netto: r.betrag, stundensatz: r.preis, dienstleistungen_je_aufgabe: r.aufgaben_dl ? 'berücksichtigt' : undefined, budget: r.budget, verbraucht_bis_monatsende: r.verbraucht_bisher || undefined, rest: r.rest, ueber_budget: r.ueber_budget, datei: r.datei, ablage: r.ablage || r.pdf_auf_nas } }];\nconst e = r.error || r.fehler;\nconst grund = String((e && (e.message || e.description)) || e || 'unbekannter Fehler').replace(/\\s*\\[line \\d+\\]\\s*$/, '').trim();\nreturn [{ json: { status: 'Bericht nicht erstellt', grund } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "63eedae4-bbce-4c37-9d0a-eac05e45f0ab",
