      "parameters": {
        "jsCode": "// Ohne Recht kein Bericht: klare Antwort für Ally\n// Produktname aus der Datenbank (Recht prüfen) statt fest im Code (Stefan 18.10.2026)\nconst produkt = String($('Recht prüfen (Ally)').first().json.produkt_name || '').trim();\nconst oberflaeche = produkt ? produkt + '-Oberfläche' : 'Oberfläche';\nreturn [{ json: { status: 'Bericht nicht erstellt', grund: 'Dir fehlt das Recht „Monatsberichte erstellen“. Admins vergeben es auf der ' + oberflaeche + ' unter „Personen und Rechte“.' } }];\n",
