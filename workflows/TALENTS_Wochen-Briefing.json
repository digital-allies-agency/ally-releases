      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Gesendet? (Stefan 18.10.2026): Ergebnis je Person; nach Zeitplan einmal je Zeitraum (merken = true)\n// Migration 180 (KI-Analyse): Ergebnis je Weg (Chat, Mail; Testmodus der Mail), Text, HTML, KI und Kopf für talents_briefing_versand (Ergebnis auf der Seite KI-Analysen)\nconst s = $input.item.json || {};\nconst M = s.mail && typeof s.mail === 'object' ? s.mail : {};\nconst e = { chat: { gewaehlt: s.chat === true, ok: s.chat_ok === true },\n  mail: { gewaehlt: M.mail === true, ok: s.mail_ok === true, test: M.mail === true && M.test === true,\n    fehler: s.mail_fehler || (M.mail === true && M.senden !== true && M.test !== true ? String(M.grund || '') : '') },\n  text: String(s.text || ''), html: String(s.html || ''), ki: s.ki === true, kopf: s.kopf && typeof s.kopf === 'object' ? s.kopf : {} };\nreturn { json: { user_id: s.user_id, woche: s.woche, merken: s.merken === true, e: JSON.stringify(e) } };\n"
      }
    },
