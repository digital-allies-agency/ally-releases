    {
      "id": "f6e441a2-a3c2-4459-aedc-9882a1fb654a",
      "name": "KI-Text zusammenfügen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// KI-Text des Briefings (Stefan 18.10.2026): alle Textteile zusammenfügen; die Datenbank liest daraus nur gültige Punkte ohne fremde Zahlen\nconst c = $input.item.json.content;\nconst ki_text = (Array.isArray(c) ? c : []).filter(b => b && b.type === 'text' && b.text).map(b => String(b.text)).join('\\n').trim();\nreturn { json: { ki_text } };\n"
      }
    },
