        "jsCode": "// Testlauf: zeigt, was gesendet würde; es wird nichts gesendet und nichts gemerkt (Migration 180: auch die Mail nur als Vorschau)\nreturn $input.all().map(i => ({ json: { vorschau: 'würde senden (Testlauf, nichts gesendet, nichts gemerkt)', an: i.json.user_id, room_id: i.json.room_id,\n  chat: i.json.chat === true, mail: i.json.mail && i.json.mail.mail === true ? { an: i.json.mail.an, von: i.json.mail.von, betreff: i.json.mail.betreff, test: i.json.mail.test === true,\n    grund: i.json.mail.grund || '' } : null, ki: i.json.ki, text: i.json.text } }));\n"
