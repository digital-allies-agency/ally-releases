        "query": "-- Fällige Wochen-Briefings (Tag und Uhrzeit unter Einstellungen › Talents, einmal je Kalenderwoche, Schalter talents_briefing) mit Zahlen\n-- und fertiger Anfrage an die KI. $1 = Testlauf (alle, ohne Zeitprüfung), $2 = nur diese Person (Start durch Ally) (Stefan 18.10.2026)\nSELECT talents_briefing_faellig($1::boolean, $2::text) AS r;",
        "options": {
          "queryReplacement": "={{ [ $('Testlauf (manuell)').isExecuted, $('Start durch Ally').isExecuted ? String(($('Start durch Ally').first().json || {}).nutzer || '').trim() || '-' : '' ] }}"
