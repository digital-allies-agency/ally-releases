    {
      "id": "a421030f-5399-425d-a004-e52e3c41cbe6",
      "name": "Senden vorbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Senden vorbereiten (Stefan 18.10.2026): Nachricht aus talents_briefing_text(), Empfänger aus der Person\n// Migration 180 (KI-Analyse): Zustellung je Person aus talents_briefing_faellig (chat, mail; nur in Ally = beides aus), die fertige Mail aus talents_briefing_mail\n// und der Kopf des Ergebnisses (kopf) für talents_briefing_versand\nconst p = $('Personen aufteilen').item.json;\nconst n = $('Nachricht bauen').item.json.n || {};\nconst m = $input.item.json.m && typeof $input.item.json.m === 'object' ? $input.item.json.m : { mail: false };\nif (!n.text || !n.html) throw new Error('KI-Analyse: Nachricht für ' + p.user_id + ' ist leer.');\nconst V = p.person && p.person.versand && typeof p.person.versand === 'object' ? p.person.versand : { chat: false, mail: false };\nreturn { json: { user_id: p.user_id, room_id: String(p.person.room_id || ''), woche: String(p.person.woche || ''), text: String(n.text), html: String(n.html),\n  ki: n.ki === true, test: p.test, merken: p.merken, chat: V.chat === true && !!p.person.room_id, mail: V.mail === true ? m : { mail: false },\n  kopf: p.person.kopf && typeof p.person.kopf === 'object' ? p.person.kopf : {} } };\n"
      }
    },
