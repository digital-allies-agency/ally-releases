      },
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "UJpN09uPs1n9LVAk",
          "name": "Postgres n8n_data"
        }
      }
    },
    {
      "id": "215362cb-90b1-4dd8-91ec-9d8fb82e3137",
      "name": "Personen aufteilen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Personen aufteilen (Stefan 18.10.2026): ein Eintrag je Person aus talents_briefing_faellig(). Testlauf (manuell) sendet und merkt nichts;\n// Start durch Ally sendet, merkt die Woche aber nicht (wie das Morgen-Briefing).\nconst r = $input.first().json.r || {};\nif (r.ok !== true) throw new Error('Wochen-Briefing: ' + String(r.fehler || 'Die Daten sind nicht lesbar.').slice(0, 200));\nconst test = $('Testlauf (manuell)').isExecuted;\nconst ally = $('Start durch Ally').isExecuted;\nreturn (Array.isArray(r.personen) ? r.personen : []).filter(p => p && p.user_id && Array.isArray(p.talents) && p.talents.length)\n  .map(p => ({ json: { person: p, user_id: String(p.user_id), ki: p.ki === true && !!p.modell, modell: String(p.modell || ''),\n    system: String(p.system || ''), nachricht: String(p.nachricht || ''), test, merken: !test && !ally && $execution.mode === 'production' } }));\n"
      }
    },
