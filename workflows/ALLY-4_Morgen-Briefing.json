      "onError": "continueRegularOutput",
      "notes": "Migration 208 (eine Funktion „Briefing“, Stefan 06.11.2026): Bausteine mit art ablauf (briefing_bausteine.ablauf = Kennung des Unterablaufs); Ausgabe { schluessel, zeilen }",
      "id": "b208-bausteine-aus-abläufen"
    },
    {
      "parameters": {
        "jsCode": "// Migration 208 (eine Funktion „Briefing“, Stefan 06.11.2026): Zeilen je Baustein aus den Unterabläufen (zugeordnet über schluessel, sonst über die Reihenfolge); Fehler = „Konnte gerade nicht gelesen werden.“\nconst vor = $('Ablauf-Aufträge').all().map(i => i.json);\nconst R = $input.all().map(i => i.json || {});\nconst ablauf = vor.map((v, k) => { const r = R.find(x => x && x.schluessel === v.schluessel) || (R.length === vor.length ? R[k] : null) || {};\n  return { schluessel: v.schluessel, zeilen: Array.isArray(r.zeilen) ? r.zeilen.slice(0, 50) : [], fehler: r.error ? String(r.error.message || r.error).slice(0, 200) : (Array.isArray(r.zeilen) ? '' : 'keine Zeilen') }; });\nreturn [{ json: Object.assign({}, $('Termine sammeln').first().json, { ablauf }) }];",
        "mode": "runOnceForAllItems"
