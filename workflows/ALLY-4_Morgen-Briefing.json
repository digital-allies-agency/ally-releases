    {
      "parameters": {
        "jsCode": "// Migration 208 (eine Funktion „Briefing“, Stefan 06.11.2026): ein Eintrag je Auftrag aus briefing_faellig; ohne Auftrag die Antwort (für das Chat-Werkzeug)\nconst r = $input.first().json.r || {};\nif (r.ok !== true) throw new Error('Briefing: ' + String(r.fehler || 'Die Daten sind nicht lesbar.').slice(0, 200));\nconst A = (Array.isArray(r.auftraege) ? r.auftraege : []).filter(a => a && a.briefing_id && a.person);\nif (!A.length) return [{ json: { fertig: true, antwort: String(r.antwort || 'Kein Briefing fällig.') } }];\nreturn A.map(a => ({ json: { auftrag: a } }));",
        "mode": "runOnceForAllItems"
