      "notes": "Migration 208 (eine Funktion „Briefing“, Stefan 06.11.2026): nur für Aufträge mit dem Baustein „Termine“ und hinterlegtem Google-Kalender der Person (kalender_id)"
    },
    {
      "parameters": {
        "jsCode": "// Migration 208 (eine Funktion „Briefing“, Stefan 06.11.2026): Termine aus dem Google-Kalender (falls abgefragt) als Zeilen mit Sortierschlüssel; der Auftrag kommt aus „Pro Auftrag“\nconst A = $('Pro Auftrag').first().json.auftrag;\nconst ein = $input.all().map(i => i.json || {});\nconst vomKalender = !(ein.length === 1 && ein[0].auftrag);\nconst zeit = d => DateTime.fromISO(d).setZone('Europe/Berlin').toFormat('HH:mm');\nlet eintraege = [], fehler = false;\nif (vomKalender) {\n  fehler = ein.some(e => e && e.error);\n  eintraege = ein.filter(e => e && e.id && e.start).map(e => { const ganz = !(e.start && e.start.dateTime);\n    return { sort: ganz ? '00:00' : zeit(e.start.dateTime), t: (ganz ? 'ganztägig' : zeit(e.start.dateTime) + (e.end && e.end.dateTime ? '–' + zeit(e.end.dateTime) : '')) + ' · ' + (e.summary || '(ohne Titel)') + (e.location ? ' · ' + e.location : '') }; });\n}\nreturn [{ json: { auftrag: A, google: { eintraege, fehler } } }];",
        "mode": "runOnceForAllItems"
      },
