    {
      "id": "ce67ddbc-17cf-465e-8db3-4e35c93ee713",
      "name": "Antwort formatieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        -96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Antwort formatieren (ALLY 1T, Kopie von ALLY 1 6_9b): Wandelt Allys Markdown-Antwort in das Chat-Layout um (Vorgabe Stefan, 11.10.2026):\n// Titel fett mit Doppelpunkt, Inhalt direkt darunter, Leerzeile zwischen Bloecken, Aufzaehlungen als Zeilen mit Gedankenstrich, keine Emojis.\nconst ohneEmoji = v => String(v ?? '').replace(/[\\p{Extended_Pictographic}️‍]/gu, '').replace(/[ \\t]{2,}/g, ' ').replace(/^ +/gm, '');\n// Markdown-Tabellen kann der Chat nicht darstellen: jede Tabellenzeile wird ein Block mit fettem Titel (erste Spalte)\n// und den übrigen Spalten als \"Spalte: Wert\" in einer Zeile.\nfunction tabellenUmwandeln(text) {\n  const z = text.split('\\n');\n  const istZeile = s => /^\\s*\\|.*\\|\\s*$/.test(s);\n  const istTrenner = s => /^\\s*\\|?\\s*:?-{2,}:?\\s*(\\|\\s*:?-{2,}:?\\s*)*\\|?\\s*$/.test(s);\n  const zellen = s => s.trim().replace(/^\\|/, '').replace(/\\|$/, '').split('|').map(x => x.trim());\n  const aus = [];\n  let i = 0;\n  while (i < z.length) {\n    if (istZeile(z[i]) && i + 1 < z.length && istTrenner(z[i + 1])) {\n      const kopf = zellen(z[i]).map(k => k.replace(/\\*\\*/g, ''));\n      i += 2;\n      while (i < z.length && istZeile(z[i])) {\n        const r = zellen(z[i]);\n        const titel = (r[0] || '').replace(/\\*\\*/g, '');\n        const rest = r.slice(1).map((v, k) => v ? (/[A-Za-zÄÖÜäöüß]/.test(kopf[k + 1] || '') ? kopf[k + 1] + ': ' + v : v) : '').filter(Boolean).join(', ');\n        aus.push('', '**' + titel + '**');\n        if (rest) aus.push(rest);\n        i++;\n      }\n      aus.push('');\n      continue;\n    }\n    aus.push(z[i]);\n    i++;\n  }\n  return aus.join('\\n');\n}\n// ALLY 1T: Text kommt aus „Antwort buchen“ (a.output) oder „Hinweis-Antwort“ (output)\nconst j0 = $input.item.json || {};\nconst md = tabellenUmwandeln(ohneEmoji(j0.output ?? (j0.a || {}).output ?? ''));\n\nfunction esc(s) {\n  return s.split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;');\n}\nfunction inline(s) {\n  s = esc(s);\n  s = s.replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1</strong>');\n  s = s.replace(/`([^`]+)`/g, '<code>$1</code>');\n  return s;\n}\nconst ohneMd = s => s.replace(/\\*\\*([^*]+)\\*\\*/g, '$1').replace(/`([^`]+)`/g, '$1');\n\nconst bloecke = [];\nlet cur = null;\nfunction neu() { if (cur && cur.h.length) bloecke.push(cur); cur = { h: [], t: [], nurTitel: false }; }\nneu();\nlet quote = null;\nfunction quoteAbschliessen() {\n  if (!quote) return;\n  neu();\n  const z = quote.filter((x, i, a) => !(x.trim() === '' && (i === 0 || i === a.length - 1)));\n  cur.h.push('<blockquote>' + z.map(x => x.trim() === '' ? '' : inline(x)).join('<br>') + '</blockquote>');\n  cur.t.push(z.map(ohneMd).join('\\n'));\n  quote = null;\n  neu();\n}\n\nfor (const roh of md.split('\\n')) {\n  const t = roh.trim();\n  if (t.startsWith('>')) { (quote = quote || []).push(t.replace(/^>\\s?/, '')); continue; }\n  quoteAbschliessen();\n  if (t === '') { if (!cur.nurTitel) neu(); continue; }\n  const titel = t.match(/^#{1,6}\\s*(.+)$/) || t.match(/^\\*\\*([^*]+)\\*\\*:?$/);\n  if (titel) {\n    neu();\n    let x = titel[1].replace(/\\*\\*/g, '').trim();\n    if (!/[:?!.]$/.test(x)) x += ':';\n    cur.h.push('<strong>' + inline(x) + '</strong>');\n    cur.t.push(x);\n    cur.nurTitel = true;\n    continue;\n  }\n  let zeile = t;\n  if (t.startsWith('- ') || t.startsWith('* ')) zeile = '– ' + t.slice(2);\n  cur.h.push(inline(zeile));\n  cur.t.push(ohneMd(zeile));\n  cur.nurTitel = false;\n}\nquoteAbschliessen();\nneu();\n\nconst html = bloecke.map(b => b.h.join('<br>')).join('<br><br>');\nconst plain = bloecke.map(b => b.t.join('\\n')).join('\\n\\n');\n\nreturn { json: { text: plain, html } };\n"
      }
    },
