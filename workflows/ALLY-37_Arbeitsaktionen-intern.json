    {
      "id": "d66888d0-4c9b-4dc9-a626-1b31010e49b6",
      "name": "Ergebnis System-Mails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        740
      ],
      "parameters": {
        "jsCode": "// Ergebnis ALLY 2: Zusammenfassung der System-Mails, steht danach auf der Seite\nconst r = $('Start').first().json.r || {};\nconst j = $input.first().json || {};\nconst fehlerText = e => String((e && (e.message || e.description)) || e || '').replace(/\\s*\\[line \\d+\\]\\s*$/, '').trim();\nif (j.error) return [{ json: { ok: false, text: 'Keine Zusammenfassung: ' + (fehlerText(j.error) || 'unbekannter Fehler.') } }];\nlet c = j.content; if (typeof c === 'string') { try { c = JSON.parse(c); } catch (e) { } }\nconst text = (Array.isArray(c) ? c : [c]).map(x => typeof x === 'string' ? x : (x && x.type === 'text' ? x.text : '')).filter(Boolean).join('\\n\\n').trim();\nif (!text) return [{ json: { ok: false, text: 'Keine Zusammenfassung erhalten.' } }];\nreturn [{ json: { ok: true, text: 'Zusammenfassung der letzten ' + r.tage + ' Tage steht unten.', ergebnis: { art: 'systemmails', tage: r.tage, text: text.slice(0, 8000) } } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
