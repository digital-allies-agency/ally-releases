        "jsCode": "// Papierkorb: Stand nach dem Löschen (ALLY 37, Migration 133): Ergebnis von SPEICHER 1 für marketing_pk_abschliessen.\nconst fehlerText = e => String((e && (e.message || e.description)) || e || '').replace(/\\s*\\[line \\d+\\]\\s*$/, '').trim();\nconst j = $input.first().json || {};\nreturn [{ json: { pfad: String(j.pfad || ''), status: j.ok === true ? 'geloescht' : 'fehler',\n  fehler: j.ok === true ? '' : (String(j.fehler || '') || fehlerText(j.error) || 'Der Ordner ließ sich nicht löschen.').slice(0, 300) } }];",
