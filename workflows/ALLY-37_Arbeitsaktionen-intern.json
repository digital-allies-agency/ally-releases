        "jsCode": "// Themenordner über SPEICHER 1 löschen (mit allen Unterordnern)\nconst r = $('Start').first().json.r || {};\nreturn [{ json: { aktion: 'loeschen', bereich: 'ally', pfad: String(r.ordner || '') } }];\n",
