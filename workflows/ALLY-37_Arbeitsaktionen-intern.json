      "position": [
        1568,
        460
      ],
      "parameters": {
        "jsCode": "// Ergebnis Kalender (anlegen, ändern, löschen)\nconst r = $('Start').first().json.r || {};\nconst j = $input.first().json || {};\nconst fehlerText = e => String((e && (e.message || e.description)) || e || '').replace(/\\s*\\[line \\d+\\]\\s*$/, '').trim();\nconst was = { termin_neu: 'angelegt', termin_aendern: 'geändert', termin_loeschen: 'gelöscht' }[r.art] || 'gespeichert';\nif (j.error) return [{ json: { ok: false, text: 'Termin nicht ' + was + ': ' + (fehlerText(j.error) || 'unbekannter Fehler.') } }];\nreturn [{ json: { ok: true, text: r.art === 'termin_loeschen' ? 'Termin gelöscht.' : 'Termin „' + (j.summary || r.titel) + '“ ' + was + '.' } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "5af036fb-cd89-41f2-9a68-8338920fd5e2",
      "name": "Ergebnis Frage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        880
      ],
      "parameters": {
        "jsCode": "// Ergebnis Ally fragen: Frage steht im Chat, ALLY 1 antwortet dort\nconst s = $('Frage in den Chat (SYS 4)').first().json || {};\nconst a = $input.first().json || {};\n// Produktname aus der Einstellung produkt_name; ohne Namen neutrale Texte (Stefan 18.10.2026)\nconst P = String($('Start').first().json.r.produkt_name || '').trim();\nif (a.error) return [{ json: { ok: false, text: 'Die Frage ist nicht ' + (P ? 'bei ' + P + ' ' : '') + 'angekommen. Bitte im Chat stellen.' } }];\nreturn [{ json: { ok: true, text: (P ? 'Deine Frage ist bei ' + P + '.' : 'Deine Frage ist angekommen.') + ' Die Antwort kommt in etwa einer halben Minute in den Chat.' + (s.error ? ' (Die Frage selbst konnte nicht in den Chat geschrieben werden.)' : '') } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "parameters": {
        "jsCode": "// Papierkorb: Ordner (ALLY 37, Migration 133): endgültig löschen von Marketing-Themen mit Ordner – ein Durchgang je Eintrag des Löschauftrags.\n// Die Nummern kommen aus der Datenbank (marketing_papierkorb, nur eigene Einträge mit Ordner); den Pfad gibt erst marketing_pk_freigeben je Durchgang heraus.\nconst r = $('Start').first().json.r || {};\nconst ids = (Array.isArray(r.ids) ? r.ids : []).map(x => String(x)).filter(x => /^[0-9]{1,18}$/.test(x)).slice(0, 1000);\nreturn ids.length ? ids.map(id => ({ json: { id } })) : [{ json: { id: '' } }];",
