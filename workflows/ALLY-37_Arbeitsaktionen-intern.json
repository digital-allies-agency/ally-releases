    {
      "id": "84e6a9ce-b2a0-4f82-a1e7-e8a400e7ca16",
      "name": "Ergebnis Löschen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        -80
      ],
      "parameters": {
        "jsCode": "// Ergebnis Löschen: erst wenn die Dateien weg sind (oder es keine gab), löscht arbeit_web_abschluss das Thema in der Datenbank\nconst r = $('Start').first().json.r || {};\nconst titel = '„' + (r.titel || 'Thema') + '“';\nif (!r.ordner) return [{ json: { ok: true, text: titel + ' ist gelöscht.' } }];\nconst j = $input.first().json || {};\nif (j.ok === true) return [{ json: { ok: true, text: titel + ' ist gelöscht, samt ' + (j.vorhanden === false ? 'Eintrag (Dateien waren schon weg).' : 'Dateien.') } }];\nreturn [{ json: { ok: false, text: titel + ' ist nicht gelöscht. Die Dateien ließen sich nicht entfernen: ' + (j.fehler || (j.error && (j.error.message || j.error)) || 'unbekannter Fehler') } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "6726a1aa-5825-4a49-a5d6-0c5f2df47f41",
      "name": "Ergebnis Mail-Entwurf",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        200
      ],
      "parameters": {
        "jsCode": "// Ergebnis ALLY 6 (Entwurf liegt im Entwürfe-Ordner des Postfachs, nichts wird verschickt)\nconst j = $input.first().json || {};\nconst fehlerText = e => String((e && (e.message || e.description)) || e || '').replace(/\\s*\\[line \\d+\\]\\s*$/, '').trim();\nif (j.error || j.status !== 'Entwurf angelegt') return [{ json: { ok: false, text: 'Kein Entwurf angelegt: ' + (fehlerText(j.error) || 'unbekannter Fehler.') } }];\nreturn [{ json: { ok: true, text: 'Entwurf liegt im Ordner „' + (j.ordner || 'Entwürfe') + '“ von ' + j.postfach + '. Er wird nicht verschickt.',\n  ergebnis: { art: 'mailentwurf', postfach: String(j.postfach || ''), an: String(j.an || ''), betreff: String(j.betreff || ''), text: String(j.entwurf || '').slice(0, 6000) } } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
