    {
      "parameters": {
        "jsCode": "// Papierkorb: Stand ohne Löschen (ALLY 37, Migration 133): SPEICHER 1 hat keinen eindeutigen Ordner gemeldet – nichts gelöscht.\n// fehlte = nicht (mehr) vorhanden (Eintrag darf weg), nicht_erkannt = vorhanden, aber nicht eindeutig ein Ordner, fehler = Prüfen fehlgeschlagen.\nconst fehlerText = e => String((e && (e.message || e.description)) || e || '').replace(/\\s*\\[line \\d+\\]\\s*$/, '').trim();\nconst j = $input.first().json || {};\nconst pfad = String(j.pfad || '');\nif (j.ok === false || j.weg === 'fehler' || j.error) return [{ json: { pfad, status: 'fehler', fehler: (String(j.fehler || '') || fehlerText(j.error) || 'Prüfen fehlgeschlagen.').slice(0, 300) } }];\nif (j.vorhanden === false) return [{ json: { pfad, status: 'fehlte' } }];\nreturn [{ json: { pfad, status: 'nicht_erkannt' } }];",
        "mode": "runOnceForAllItems"
      },
