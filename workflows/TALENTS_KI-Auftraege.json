    {
      "id": "e9f0f4ea-fadb-4e6c-8021-82a80fe93df3",
      "name": "Meldungen bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        500
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Kooperations-Meldungen bauen (Stefan 18.10.2026): eine Chat-Nachricht je Meldung und Empfänger (Titel fett mit Doppelpunkt, keine Emojis).\n// Testläufe (alles außer production) senden nichts und merken nichts.\nconst test = $execution.mode !== 'production';\nconst r = $input.first().json.r || {};\nif (r.ok !== true) throw new Error('Kooperations-Meldungen: ' + String(r.fehler || 'nicht lesbar').slice(0, 200));\nconst ohneEmoji = v => String(v ?? '').replace(/[\\p{Extended_Pictographic}️‍]/gu, '').trim();\nconst esc = v => ohneEmoji(v).split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;');\nconst out = [];\nfor (const m of Array.isArray(r.meldungen) ? r.meldungen : []) {\n  const id = Number(m && m.zuordnung_id);\n  if (!(id > 0)) continue;\n  const titel = ohneEmoji(m.titel).replace(/:\\s*$/, '') + ':';\n  const text = ohneEmoji(m.text);\n  const html = '<strong>' + esc(titel) + '</strong><br>' + text.split('\\n').map(esc).join('<br>');\n  const empf = Array.isArray(m.empfaenger) ? m.empfaenger : [];\n  // Ohne Empfänger (niemand zuständig oder Schalter aus) wird nichts gesendet; talents_kooperation_meldungen zeigt Meldungen nur 14 Tage lang\n  for (const e of empf) {\n    const roomId = String((e && e.room_id) || '').trim();\n    const userId = String((e && e.user_id) || '').trim();\n    if (!roomId && !userId) continue;\n    out.push({ json: { zuordnung_id: id, user_id: userId, room_id: roomId, text: titel + '\\n' + text, html, test } });\n  }\n}\nreturn out;\n"
      }
    },
