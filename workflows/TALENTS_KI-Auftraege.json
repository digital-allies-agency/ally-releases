    {
      "id": "62bd8c8a-92d3-48bb-8729-18db327b02fd",
      "name": "Fehlertext",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Fehlertext eines KI-Aufrufs (Stefan 18.10.2026): kurz, ohne Schlüssel (die Datenbank bereinigt zusätzlich)\nconst s = $('Schritte aufteilen').item.json;\nconst e = $input.item.json.error;\nconst text = String((e && (e.message || e.description)) || e || 'KI nicht erreichbar').slice(0, 300);\nreturn { json: { auftrag_id: s.auftrag_id, fehler: text } };\n"
      }
    },
