      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Fertige Kooperationsanfragen (Vorschlag und Entwurf erledigt), noch nicht gemeldet, mit Empfängern (Schalter talents_kooperation)\nSELECT talents_kooperation_meldungen() AS r;",
        "options": {}
      },
      "executeOnce": true,
