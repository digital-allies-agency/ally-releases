    {
      "id": "3402b0a8-0339-4d77-8a60-57f9d8fb047a",
      "name": "Antwort zusammenfügen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Antwort zusammenfügen (Stefan 18.10.2026): alle Textteile der KI-Antwort (neuere Modelle liefern mehrere Blöcke, teils mit leerem\n// thinking-Block davor) und die Adressen aller Suchergebnisse (web_search_tool_result) bzw. Zitate. Die Datenbank prüft damit die Quellen.\nconst s = $('Schritte aufteilen').item.json;\nconst c = $input.item.json.content;\nconst bloecke = Array.isArray(c) ? c : [];\nconst text = bloecke.filter(b => b && b.type === 'text' && b.text).map(b => String(b.text)).join('\\n').trim();\nconst quellen = new Set();\nfor (const b of bloecke) {\n  if (b && b.type === 'web_search_tool_result' && Array.isArray(b.content)) {\n    for (const e of b.content) if (e && typeof e.url === 'string' && /^https?:\\/\\//i.test(e.url)) quellen.add(e.url);\n  }\n  if (b && b.type === 'text' && Array.isArray(b.citations)) {\n    for (const z of b.citations) if (z && typeof z.url === 'string' && /^https?:\\/\\//i.test(z.url)) quellen.add(z.url);\n  }\n}\nreturn { json: { auftrag_id: s.auftrag_id, schritt: s.schritt, art: s.art,\n  daten: { text, quellen: [...quellen].slice(0, 200), websuchen: Number($input.item.json.websuchen) || 0 } } };\n"
      }
    },
    {
      "id": "c18d2c6e-8f00-4517-800c-c7fea6c77ab3",
      "name": "Ergebnis speichern",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1760,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Die Datenbank prüft die Antwort (gültiges JSON, nur belegte Werte und Quellen) und speichert sie (Stefan 18.10.2026)\nSELECT talents_ki_ergebnis($1::integer, $2::integer, $3::jsonb) AS r;",
