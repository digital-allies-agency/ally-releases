      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// KI-Schritte aufteilen (Stefan 18.10.2026): ein Eintrag je Schritt aus talents_ki_schritte(); während der KI-Sperre keine Schritte.\nconst r = $input.first().json.r || {};\nif (r.ok !== true) throw new Error('KI-Aufträge: ' + String(r.fehler || 'Die Schritte sind nicht lesbar.').slice(0, 200));\nreturn (Array.isArray(r.schritte) ? r.schritte : [])\n  .filter(s => s && Number(s.auftrag_id) > 0 && s.modell && s.system && s.nachricht)\n  .map(s => ({ json: { auftrag_id: Number(s.auftrag_id), schritt: Number(s.schritt), art: String(s.art), modell: String(s.modell),\n    system: String(s.system), nachricht: String(s.nachricht), max_tokens: Math.min(Math.max(Number(s.max_tokens) || 2000, 200), 8000),\n    websuche: s.websuche === true, max_suchen: Math.min(Math.max(Number(s.max_suchen) || 1, 1), 10), user: String(s.user || '') } }));\n"
      }
