    {
      "id": "d00260f2-905e-457a-8529-000bc478c105",
      "name": "Gesendet auswerten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Gesendet auswerten (Stefan 18.10.2026): eine Meldung gilt als gemeldet, wenn sie mindestens einem Empfänger zugestellt wurde.\n// Gelingt das Senden an niemanden, bleibt sie offen (nächster Lauf).\nconst gesendet = $input.all();\nconst quelle = $('Testlauf?').all(1);\nconst gruppen = {};\ngesendet.forEach((it, i) => {\n  let q = quelle[i];\n  if (quelle.length !== gesendet.length) {\n    const p = Array.isArray(it.pairedItem) ? it.pairedItem[0] : it.pairedItem;\n    q = p && typeof p.item === 'number' ? quelle[p.item] : undefined;\n  }\n  if (!q || !q.json) return;\n  const j = it.json || {};\n  const g = gruppen[q.json.zuordnung_id] = gruppen[q.json.zuordnung_id] || { zuordnung_id: q.json.zuordnung_id, gesendet: 0, test: q.json.test };\n  if (!j.error && j.ok !== false) g.gesendet++;\n});\nreturn Object.values(gruppen).filter(g => g.gesendet > 0 && g.test === false).map(g => ({ json: g }));\n"
      }
    },
