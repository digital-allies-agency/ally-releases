        },
        "query": "-- Benachrichtigung in der Oberfläche zur Chat-Nachricht (BA4, Stefan 20.10.2026): nur wenn der Aufrufer art mitgibt; sonst nichts.\n-- Empfänger wie im Chat (user_id bzw. Direktraum einer Person). Doppelschutz über ref. Wirft nie einen Fehler; das Senden läuft unabhängig davon.\nSELECT CASE WHEN coalesce($2::text, '') = '' THEN NULL ELSE ally_benachrichtigung_aus_chat($1::text, $2::text, nullif($3::text, ''), nullif($4::text, ''), nullif($5::text, ''), 'SYS 4') END AS r;"
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
