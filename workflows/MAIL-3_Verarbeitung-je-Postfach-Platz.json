    {
      "id": "e6e3f55c-3be5-40d3-83c2-6498fd83129d",
      "name": "3_5 Anhang vorbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const binaryKeys = Object.keys($input.item.binary || {});\nconst invoiceKey = binaryKeys.find(key => {\n  const ext = $input.item.binary[key].fileExtension;\n  return ext === 'pdf' || ext === 'xml';\n});\nif (!invoiceKey) {\n  throw new Error('Kein PDF/XML-Anhang gefunden, obwohl der Filter davor das Item durchgelassen hat.');\n}\nconst extension = $input.item.binary[invoiceKey].fileExtension;\nconst senderRaw = ($input.item.json.from && $input.item.json.from.value && $input.item.json.from.value[0] && $input.item.json.from.value[0].address) || 'unbekannt';\nconst safeSender = senderRaw.replace(/[\\/\\\\:*?\"<>|]/g, '_');\nconst emailDate = new Date($input.item.json.date);\nconst dateStr = emailDate.toISOString().slice(0, 10);\nconst timeStr = emailDate.toISOString().slice(11, 19).replace(/:/g, '-');\nconst randomSuffix = Math.random().toString(36).substring(2, 6);\nconst stagingFileName = `${dateStr}_${timeStr}_${safeSender}_${randomSuffix}.${extension}`;\nreturn {\n  json: {\n    ...$input.item.json,\n    invoiceFileName: $input.item.binary[invoiceKey].fileName,\n    invoiceFileExtension: extension,\n    stagingFileName: stagingFileName\n  },\n  binary: { invoiceAttachment: $input.item.binary[invoiceKey] }\n};"
      }
    },
