    {
      "id": "3346595a-9b01-451d-92c4-988cd9265612",
      "name": "3_3 Postfach zuordnen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        240
      ],
      "parameters": {
        "jsCode": "// Das Postfach kommt ausschließlich aus der Platz-Liste, nie aus dem Inhalt der Mail.\nconst info = $input.first().json.info || {};\nconst pruef = $('3_1 Platz prüfen').first().json;\nconst abbruch = (meldung) => {\n  // Testläufe: nur Ergebnis zurückgeben, keine Fehlermeldung auslösen\n  if (pruef.test === true) return [];\n  throw new Error(meldung);\n};\nif (pruef.test_abbruch) return [];\nif (info.platz !== pruef.platz) return abbruch('Platz ' + pruef.platz + ' nicht gefunden. Nichts verarbeitet.');\nif (!info.adresse) return abbruch('Platz ' + pruef.platz + ' hat kein Postfach zugeordnet. Nichts verarbeitet.');\n// Pausiertes Postfach: Mails komplett ignorieren, auch Belege (wie bisher)\nif (info.aktiv !== true) return [];\nreturn $('3_0 Mail von Empfangs-Ablauf').all().map((it, i) => ({\n  json: { ...it.json, postfach: info.adresse, postfach_platz: info.platz, belege_erfassen: info.belege_erfassen === true, _test: pruef.test },\n  binary: it.binary,\n  pairedItem: { item: 0 }\n}));"
      }
    },
