    {
      "id": "aabc84f1-09c1-4312-ba21-a90a1ef12e56",
      "name": "3_3b Schon bekannt?",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        784,
        384
      ],
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [ $('3_3 Postfach zuordnen').first().json.postfach, JSON.stringify($('3_3 Postfach zuordnen').all().map(i => i.json.messageId).filter(Boolean)) ] }}"
        },
        "query": "-- Doppel-Sperre: Welche dieser Mails sind schon eingeordnet, zum Nachholen vorgemerkt oder als Beleg erfasst?\nWITH ids AS (SELECT DISTINCT jsonb_array_elements_text($2::jsonb) AS mid)\nSELECT jsonb_build_object(\n  'eingeordnet', coalesce((SELECT jsonb_agg(DISTINCT l.message_id) FROM mail_klassifizierung_log l JOIN ids ON ids.mid = l.message_id WHERE l.postfach = $1::text), '[]'::jsonb),\n  'nachholen', coalesce((SELECT jsonb_agg(n.message_id) FROM mail_nachholen n JOIN ids ON ids.mid = n.message_id WHERE n.postfach = $1::text), '[]'::jsonb),\n  'belege', coalesce((SELECT jsonb_agg(b.message_id) FROM beleg_verarbeitung b JOIN ids ON ids.mid = b.message_id), '[]'::jsonb)\n) AS b;"
      },
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "UJpN09uPs1n9LVAk",
          "name": "Postgres n8n_data"
        }
      }
    },
    {
      "id": "e0f3fd2b-603c-4ec6-912e-c9dca39c2f0e",
      "name": "3_3c Bekannte markieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        240
      ],
      "parameters": {
        "jsCode": "// Jede Mail bekommt zwei Merker: schon eingeordnet (oder zum Nachholen vorgemerkt) und schon als Beleg erfasst\nconst b = $input.first().json.b || {};\nconst eingeordnet = new Set([...(b.eingeordnet || []), ...(b.nachholen || [])]);\nconst belege = new Set(b.belege || []);\nreturn $('3_3 Postfach zuordnen').all().map(it => ({\n  json: { ...it.json,\n    einordnung_bekannt: !!it.json.messageId && eingeordnet.has(it.json.messageId),\n    beleg_bekannt: !!it.json.messageId && belege.has(it.json.messageId) },\n  binary: it.binary,\n  pairedItem: { item: 0 }\n}));"
      }
    },
