    {
      "id": "8cae24fa-5b34-4856-9a97-a32b5d8e3951",
      "name": "3_1 Platz prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        240
      ],
      "parameters": {
        "jsCode": "// Jeder Aufruf kommt von genau einem Empfangs-Ablauf und damit von genau einem Platz.\n// Fehlt die Platznummer oder sind verschiedene Plätze gemischt, wird nichts verarbeitet.\n// Testläufe brechen nicht mit Fehler ab (sonst meldet sich die Fehlermeldung im Chat), sondern liefern nur das Ergebnis.\nconst items = $input.all();\nconst test = items.some(i => i.json._test === true);\nconst plaetze = [...new Set(items.map(i => i.json.postfach_platz))];\nif (plaetze.length !== 1 || !Number.isInteger(plaetze[0])) {\n  const meldung = 'Aufruf ohne eindeutige Platznummer (' + JSON.stringify(plaetze) + '). Nichts verarbeitet.';\n  if (test) return [{ json: { test_abbruch: meldung, platz: null, test } }];\n  throw new Error(meldung);\n}\nreturn [{ json: { platz: plaetze[0], test, anzahl: items.length } }];"
      }
    },
    {
      "id": "e119f6b3-90c2-45c7-bbbe-66f394f1f96d",
      "name": "3_2 Platz laden",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        448,
        240
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT postfach_platz_info($1::integer) AS info;",
        "options": {
          "queryReplacement": "={{ [ $json.platz ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "UJpN09uPs1n9LVAk",
          "name": "Postgres n8n_data"
        }
      }
