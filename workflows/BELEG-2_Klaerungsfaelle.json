      "parameters": {
        "jsCode": "// Abgelegt? Ohne vollständig abgelegte Nachreichung wird der Beleg nicht umgestellt\nconst r = $input.item.json || {};\nif (r.ok !== true) throw new Error('Nachgereichter Beleg konnte nicht abgelegt werden' + (r.ort ? ' (' + r.ort + ')' : '') + ': ' + (r.fehler || 'unbekannter Fehler'));\nreturn { json: $('3_16_neuen_anhang_vorbereiten').item.json };\n",
