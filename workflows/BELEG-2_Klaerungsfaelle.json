    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const trigger = $('3_1_klaerung_verarbeiten_trigger').item.json;\nconst triggerBinary = $('3_1_klaerung_verarbeiten_trigger').item.binary || {};\nconst klaerungsfall = $('3_2_klaerungsfall_laden').item.json;\nconst beleg = $('3_3_beleg_laden').item.json;\n\nconst hatAnhang = Object.values(triggerBinary).some(b => ['pdf', 'xml'].includes(b.fileExtension));\n\nreturn {\n  json: {\n    klaerungsfall_id: klaerungsfall.id,\n    beleg_id: beleg.id,\n    grund: klaerungsfall.grund,\n    vorschlag_text: klaerungsfall.vorschlag_text || '',\n    staging_bereich: beleg.datei_bereich,\n    staging_pfad: beleg.datei_pfad,\n    original_subject: beleg.subject,\n    original_sender: beleg.sender,\n    source_mailbox: beleg.source_mailbox,\n    antwort_text: trigger.antwort_text || '',\n    hat_anhang: hatAnhang\n  },\n  binary: triggerBinary\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        -96
      ],
      "id": "5f9ff7b7-e212-4fd1-8965-dda32f249923",
      "name": "3_4_kontext_zusammenfuehren"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('KI-Modell laden').first().json.modell_einfach }}"
        },
        "messages": {
          "values": [
            {
              "content": "=Du wertest die Antwort auf eine Klärungs-Nachricht zu einem Buchhaltungsbeleg aus.\n\nUrsprüngliche Klärungsnachricht (mit Vorschlag):\n{{ $json.vorschlag_text || $json.grund }}\n\nAntwort der Person: {{ $json.antwort_text }}\nEin Dokument war der Antwort angehängt: {{ $json.hat_anhang }}\n\nEntscheide:\n- \"manuell\": Die Person will den Beleg SELBST in Papierkram anlegen (z.B. \"mache ich manuell\", \"kümmere mich selbst\").\n- \"duplikat\": Die Person bestätigt, dass diese Rechnung schon erfasst ist und nicht gebucht werden soll (z.B. \"ist Duplikat\", \"hatte ich schon geschickt\", \"ist doppelt\").\n- \"klaerung\": Die Person bestätigt oder korrigiert den Vorschlag oder liefert eine Information oder ein Dokument, so dass die automatische Verarbeitung fortgesetzt werden soll. Ein einfaches \"ja\" bedeutet: Vorschlag bestätigt. \"ist kein Duplikat, bitte buchen\" ist ebenfalls \"klaerung\".\n\nAntworte AUSSCHLIESSLICH mit einem JSON-Objekt:\n\n{\"einordnung\": \"manuell\", \"hinweis_text\": \"\"}\n\noder\n\n{\"einordnung\": \"duplikat\", \"hinweis_text\": \"\"}\n\noder\n\n{\"einordnung\": \"klaerung\", \"hinweis_text\": \"Ein Satz: was genau bestätigt oder korrigiert wurde (konkrete Werte nennen)\"}"
            }
          ]
        },
        "options": {},
        "simplify": false
      },
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        1248,
        -96
      ],
      "id": "8b1ac082-7a9c-4581-a918-57ac8469dac0",
      "name": "3_5_antwort_einordnen_claude",
      "credentials": {
        "anthropicApi": {
          "id": "DDJojJH4rilFh8gS",
          "name": "KI-Zugang (Anthropic)"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const kontext = $('3_4_kontext_zusammenfuehren').item.json;\n// Alle Text-Teile der KI-Antwort lesen: neuere Modelle liefern davor einen (leeren) thinking-Block (Stefan 18.10.2026)\nconst kiTeile = $input.item.json.content;\nconst rawText = (Array.isArray(kiTeile) ? kiTeile : []).filter(b => b && b.type === 'text' && b.text).map(b => String(b.text)).join('\\n') || $input.item.json.text || '';\n\nconst match = rawText.match(/\\{[\\s\\S]*\\}/);\nif (!match) {\n  throw new Error('Keine JSON-Antwort in der Claude-Ausgabe gefunden: ' + rawText);\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(match[0]);\n} catch (e) {\n  throw new Error('JSON-Antwort von Claude war fehlerhaft: ' + match[0]);\n}\n\n// Hinweis fuer WF2 deterministisch bauen: die woertliche Antwort + die urspruengliche Klaerungsnachricht\n// (inkl. Vorschlag). So weiss die Extraktion beim naechsten Lauf, was bestaetigt bzw. korrigiert wurde.\nlet hinweis = 'Antwort auf die Klärungsfrage: \"' + kontext.antwort_text + '\". '\n  + 'Ein \"ja\"/\"passt\"/\"ok\" bedeutet: Der Vorschlag aus der Klärungsnachricht ist bestätigt – buche den Beleg genau so, ohne erneute Rückfrage. '\n  + 'Nennt die Antwort korrigierte Werte, übernimm diese.';\nif (parsed.hinweis_text) hinweis += ' Zusammenfassung: ' + parsed.hinweis_text;\nif (kontext.vorschlag_text) hinweis += '\\n\\nUrsprüngliche Klärungsnachricht:\\n' + kontext.vorschlag_text;\n\nreturn {\n  json: {\n    ...kontext,\n    einordnung: parsed.einordnung,\n    hinweis_text: hinweis\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        -96
