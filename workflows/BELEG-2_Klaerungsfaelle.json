    {
      "id": "70771280-41dc-4cfa-81c1-593f20b0de63",
      "name": "Ergebnis bei KI-Sperre",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
        -300
      ],
      "parameters": {
        "jsCode": "// KI-Budget-Sperre (Stefan 18.10.2026): Antwort nicht per KI eingeordnet. Der Klaerungsfall bleibt offen und kann nach Aufhebung der Sperre erneut beantwortet werden.\n// Rueckgabe wie bei einem Fehler des Unterablaufs (Feld error), damit Aufrufer (ALLY 13 'Ergebnis Klärung', Ally-Werkzeug) den Grund anzeigen; keine Fehler-Ausfuehrung.\nconst m = $('KI-Modell laden').first().json;\nconst text = String(m.ki_sperre_text || '').trim() || 'Das KI-Budget für diesen Monat ist erreicht.';\nreturn [{ json: { ok: false, gesperrt: true, klaerungsfall_id: $input.first().json.klaerungsfall_id, error: text, meldung: text } }];\n",
        "mode": "runOnceForAllItems"
      }
    }
