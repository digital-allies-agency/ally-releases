    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const daten = $('3_6_antwort_auswerten').item.json;\n// Der Anhang kommt aus 3_4 (KI-Schritt und 3_6 geben nur Daten weiter, keine Dateien)\nconst bin = $('3_4_kontext_zusammenfuehren').item.binary || $input.item.binary || {};\nconst key = Object.keys(bin).find(k => ['pdf', 'xml'].includes(bin[k].fileExtension));\n\nif (!key) {\n  throw new Error('Antwort enthält keinen PDF/XML-Anhang, obwohl hat_anhang=true war.');\n}\n\n// Nachgereichter Beleg kommt in den Eingang (SPEICHER 1, Bereich ally, Server oder eigener Speicherort)\nconst ext = bin[key].fileExtension;\nconst neuerPfad = `Belegerfassung/Belege-Staging/beleg-${daten.beleg_id}-nachreichung.${ext}`;\n\nreturn {\n  json: { ...daten, neuer_staging_pfad: neuerPfad, aktion: 'ablegen', bereich: 'ally', pfad: neuerPfad, ueberschreiben: true },\n  binary: { datei: bin[key] }\n};\n"
      },
