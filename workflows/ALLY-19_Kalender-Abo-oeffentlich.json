{
  "id": "zGCyOEGQ3PDx2fQB",
  "name": "ALLY 19 – Kalender-Abo (öffentlich)",
  "description": "Öffentliche, geheime Kalender-Abo-Adresse (BA8): GET /webhook/app/kalender?t=… liefert die eigenen Termine, Aufgaben und Deadlines als text/calendar (ally_kalender_ics), sonst 404. Speichert keine Ausführungsdaten.",
  "nodes": [
    {
      "id": "ea67057b-383c-4028-af91-e5bf17179e84",
      "name": "Kalender-Abo",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "GET",
        "path": "app/kalender",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "d539f553-2eac-4b13-8d27-c2492f97a5a8"
    },
    {
      "id": "ef4c1707-258e-4232-a047-6ec6cfc6ff6f",
      "name": "Anfrage lesen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Kalender-Abo (ALLY 19, BA8, Stefan 20.10.2026): öffentliche, geheime Abo-Adresse /webhook/app/kalender?t=<64 Hex-Zeichen> für Kalender-Apps.\n// Nur der Code aus der Adresse geht an die Datenbank (ally_kalender_ics prüft, ob das Abo aktiv ist, und liefert nur eigene Einträge). Keine Ausführungsdaten.\nconst q = ($input.first().json || {}).query || {};\nconst t = String(Array.isArray(q.t) ? q.t[0] : (q.t ?? '')).trim().toLowerCase();\nreturn [{ json: { t: /^[0-9a-f]{64}$/.test(t) ? t : '' } }];\n"
      }
    },
    {
      "id": "73322b0a-c458-4b5b-af9d-1104ccb0a978",
      "name": "Kalender laden",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT CASE WHEN $1::text ~ '^[0-9a-f]{64}$' THEN ally_kalender_ics($1::text) END AS ics;",
        "options": {
          "queryReplacement": "={{ [ $json.t ] }}"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "UJpN09uPs1n9LVAk",
          "name": "Postgres n8n_data"
        }
      }
    },
    {
      "id": "680cbadb-8188-4a94-9620-313987016463",
      "name": "Gefunden?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ typeof $json.ics === 'string' && $json.ics.startsWith('BEGIN:VCALENDAR') }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "d1e7949e-79cf-4d3a-a2bf-f036420e7746",
      "name": "Kalender ausgeben",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        880,
        200
      ],
      "parameters": {
