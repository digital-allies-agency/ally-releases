                "value": "nosniff"
              },
              {
                "name": "X-Robots-Tag",
                "value": "noindex, nofollow"
              }
            ]
          }
        }
      }
    },
    {
      "id": "82c21849-7059-47ba-a1db-327dfd0defcb",
